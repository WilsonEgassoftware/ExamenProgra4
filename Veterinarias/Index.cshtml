@model IEnumerable<ExamenProgreso1_EgasW.Models.Veterinaria>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.fechadevisita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.motivovisita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombreVeterinario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.vacunas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.costo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.fechadevisita)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.motivovisita)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombreVeterinario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.vacunas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.costo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
